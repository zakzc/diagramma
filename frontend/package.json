{
  "name": "diagramma-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gen:api": "uv run --project ../backend python ../backend/scripts/dump_openapi.py > .openapi.json && openapi-typescript .openapi.json -o src/api/schema.d.ts && rm .openapi.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/view": "^6.43.15",
    "@tanstack/react-query": "^5.108.0",
    "@uiw/react-codemirror": "^4.25.12",
    "codemirror-lang-mermaid": "0.5.0",
    "mermaid": "12.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-zoom-pan-pinch": "4.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
